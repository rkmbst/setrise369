🚀 طريقة الاستخدام في main.dart

```dart
import 'package:flutter/material.dart';
import 'beast_client.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  @override
  _HomeScreenState createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  @override
  void initState() {
    super.initState();
    // تهيئة الوحش الصغير
    BeastClient().init(
      userId: 'user_123', // استبدل بمعرف المستخدم الفعلي
      context: context,
    );
    BeastClient().setScreen('HomeScreen');
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Home')),
      body: ListView.builder(
        itemCount: 100,
        itemBuilder: (ctx, i) {
          return ListTile(
            title: Text('Item $i'),
            onTap: () {
              BeastClient().trackButton('item_$i');
              // يمكن جلب توصيات وعرضها
            },
          );
        },
      ),
    );
  }
}
