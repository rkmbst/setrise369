```python
from fastapi import Request

@app.post("/v5/events/batch")
async def receive_batch(request: Request):
    data = await request.json()
    user_id = data.get("user_id")
    events = data.get("events", [])
    for ev in events:
        # تحديث نفسية المستخدم أو النموذج
        await brain.process_feedback.remote(
            user_id=user_id,
            item_id=ev.get("data", {}).get("video_id", ""),
            reward=0.5,  # يمكن حسابها من نوع الحدث
            event_type=ev.get("event_type"),
            duration_ms=ev.get("data", {}).get("duration_ms", 0),
        )
    return {"status": "ok", "received": len(events)}
